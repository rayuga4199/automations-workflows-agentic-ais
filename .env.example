# Copy to .env and fill in. .env is git-ignored. Names only here, never real values.
# n8n stores most credentials in its own credential store; these are for local setup and any Code-node access.

# n8n instance
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# LLM provider (provider not chosen yet)
LLM_API_KEY=

# Zotero (projects 01, 07)
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# Scholarly sources (project 01). Cap spend per run.
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Google (project 07)
GOOGLE_DOC_ID=
