# Copy to .env and fill in. .env is git-ignored. Names only here, never real values.
# The n8n workflows keep their credentials in n8n's own credential store (Credentials screen).
# These variables are only for local setup. The Research and Conference Hunter needs none of them
# in its default keyword mode. The Insight Synthesis Engine needs a Groq credential inside n8n.

# n8n instance (self-hosted)
N8N_ENCRYPTION_KEY=

# Groq (AI steps in workflows/01-research-and-conference-hunter and workflows/02-insight-synthesis-engine).
# Create the credential inside n8n; this line is only a reminder of the name.
GROQ_API_KEY=

# OpenAlex (optional; basic use works without a key)
OPENALEX_API_KEY=
OPENALEX_MAILTO=
