    {
      "id": "94aab166-e994-48d4-b5b6-2bcbee57621f",
      "name": "Newest Papers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.openalex.org/works",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "search",
              "value": "={{ $(\"Tool Input\").first().json.query }}"
            },
            {
              "name": "filter",
              "value": "=from_publication_date:{{ $now.minus({ years: 2 }).toFormat(\"yyyy-MM-dd\") }},to_publication_date:{{ $now.toFormat(\"yyyy-MM-dd\") }}"
            },
            {
              "name": "per_page",
              "value": "3"
            },
            {
              "name": "select",
              "value": "title,publication_date,doi"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "fd058f98-5f2c-4cd2-8f09-adbe6b268e4b",
      "name": "Format Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function get(name) { try { return $(name).first().json || {}; } catch (e) { return {}; } }\nfunction clean(s, n) { return String(s || '').replace(/<[^>]*>/g, '').replace(/&quot;/g, '\"').replace(/&amp;/g, '&').slice(0, n); }\nconst news = (get('Latest Tech News').hits || []).slice(0, 3).map(h => ({ date: String(h.created_at || '').slice(0, 10), title: clean(h.title, 110), url: h.url || '' }));\nconst encyclopedia = (get('Encyclopedia Lookup').pages || []).slice(0, 1).map(p => ({ title: p.title, summary: clean(p.excerpt, 140) }));\nconst papers = (get('Newest Papers').results || []).slice(0, 2).map(p => ({ date: p.publication_date, title: clean(p.title, 110), doi: String(p.doi || '').replace('https://doi.org/', '') }));\nreturn [{ json: { checked_on: DateTime.now().toFormat('yyyy-MM-dd'), news, encyclopedia, papers, rule: 'Mention an item only if it truly changes a decision, and give its exact title and date. News titles are unverified headlines. Never attach these dates to anything else. If nothing applies, write: Nothing recent changes this.' } }];"
      }
    },
    {
      "id": "a4d20e00-1678-424c-9ef5-7434337b6f52",
      "name": "Sticky Note e7bc57a3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -32,
        -96
      ],
      "parameters": {
        "content": "## Latest updates\nCalled by the Design Team agents while they work. Reads three free public sources on every call, so the answer is current for that run. No API keys.",
        "color": 4,
        "width": 1360,
        "height": 224
      }
    }
  ],
