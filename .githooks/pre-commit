#!/usr/bin/env sh
# Blocks the commit if gitleaks finds a secret in staged changes.
# Enable once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed. Install it (winget install Gitleaks.Gitleaks) or the commit is unscanned." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact -v --no-banner .
